<!DOCTYPE html>
<html lang="en">
<head>
<style>
  body {
    background-color: #0a0a0a;
    margin: 0;
    height: 100vh; /* Takes up full screen height */
    display: flex;
    flex-direction: column; /* Stacks elements vertically */
    align-items: center;    /* Centers everything horizontally */
    justify-content: center; /* Centers everything vertically */
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  h1, h5 {
    color: #00d1b2;
    text-align: center;
    text-shadow: 0 0 15px #00d1b2;
    margin: 10px 0;
  }

  button {
    background-color: #1a1a1a;
    color: #00d1b2;
    border: 2px solid #00d1b2;
    padding: 20px 40px;
    border-radius: 100px;
    font-size: 14.4px;
    cursor: pointer;
    transition: 0.3s;
    margin-top: 20px;
  }

  button:hover {
    background-color: #00d1b2;
    color: #1a1a1a;
    box-shadow: 0 0 20px #00d1b2;
  }
</style>
</head>
<body>
  <h1> THIS PAGE IS UNDER CONSTRUCTION </h1>
  <h5>PLEASE COME BACK LATER</h5>
  
  <button onclick="window.location.href = 'https://www.carzzyapps.github.io'"> 
    VIEW OUR OTHER GAMES
  </button>
</body>
</html>
